{
	"servers": {
		"awesome-copilot": {
			"command": "docker",
			"args": [
				"run",
				"-i",
				"--rm",
				"ghcr.io/microsoft/mcp-dotnet-samples/awesome-copilot:latest"
			],
			"type": "stdio"
		},
		"github": {
			"type": "http",
			"url": "https://api.githubcopilot.com/mcp/"
		},
		"k8s-tools": {
			"command": "npm",
			"args": [
				"run",
				"mcp"
			],
			"cwd": "/home/optimus/Workspaces/k8sui/k8s-ui/",
			"disabled": false,
			"autoApprove": []
		}
	},
	"inputs": []
}